generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  blogs        Blog[]

  @@map("admins")
}

model Event {
  id                 String              @id @default(uuid())
  title              String
  shortDescription   String              @map("short_description")
  fullDescription    String              @map("full_description")
  bannerUrl          String              @map("banner_url")
  galleryUrls        String              @default("[]") @map("gallery_urls")
  videoUrl           String?             @map("video_url")
  eventDate          DateTime            @map("event_date")
  venue              String
  registrationLink   String?             @map("registration_link")
  sdgAlignment       String              @default("[]") @map("sdg_alignment")
  category           String
  status             String              @default("Upcoming")
  isDeleted          Boolean             @default(false) @map("is_deleted")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  rawData            String?             @map("raw_data")
  vtoolsId           String?             @unique @map("vtools_id")
  registrations      EventRegistration[]
  eventSources       EventSource[]
  media              Media[]
  organizationEvents OrganizationEvent[]

  @@index([isDeleted])
  @@index([category])
  @@index([status])
  @@index([eventDate])
  @@map("events")
}

model Organization {
  id                 String              @id @default(uuid())
  externalId         String              @unique @map("external_id")
  externalIdType     String              @default("IEEE_SPOID") @map("external_id_type")
  canonicalName      String              @map("canonical_name")
  officialName       String?             @map("official_name")
  organizationType   String?             @map("organization_type")
  parentSection      String?             @map("parent_section")
  city               String?
  country            String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  organizationEvents OrganizationEvent[]
  syncStates         SyncState?

  @@map("organizations")
}

model OrganizationEvent {
  id               String       @id @default(uuid())
  organizationId   String       @map("organization_id")
  eventId          String       @map("event_id")
  relationshipType String       @map("relationship_type")
  confidence       Float        @default(0.0)
  sourceUrl        String?      @map("source_url")
  evidence         String?
  verified         Boolean      @default(false)
  createdAt        DateTime     @default(now()) @map("created_at")
  event            Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, eventId, relationshipType])
  @@index([organizationId])
  @@index([eventId])
  @@map("organization_events")
}

model EventSource {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  sourceType  String   @map("source_type")
  sourceUrl   String   @map("source_url")
  sourceTitle String?  @map("source_title")
  retrievedAt DateTime @default(now()) @map("retrieved_at")
  contentHash String?  @map("content_hash")
  rawContent  String?  @map("raw_content")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sourceType])
  @@map("event_sources")
}

model SyncState {
  id                 String       @id @default(uuid())
  organizationId     String       @unique @map("organization_id")
  lastSuccessfulSync DateTime?    @map("last_successful_sync")
  lastSyncStatus     String?      @map("last_sync_status")
  lastSyncError      String?      @map("last_sync_error")
  totalEventsSynced  Int          @default(0) @map("total_events_synced")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("sync_states")
}

model TeamMember {
  id              String   @id @default(uuid())
  name            String
  position        String
  affiliation     String?
  contact         String?
  profileImageUrl String   @map("profile_image_url")
  linkedinUrl     String?  @map("linkedin_url")
  orderIndex      Int      @default(0) @map("order_index")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([orderIndex])
  @@map("team_members")
}

model Blog {
  id            String   @id @default(uuid())
  title         String
  content       String
  thumbnailUrl  String   @map("thumbnail_url")
  tags          String   @default("[]") @map("tags")
  publishStatus String   @default("Draft") @map("publish_status")
  authorId      String?  @map("author_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  author        Admin?   @relation(fields: [authorId], references: [id])

  @@index([publishStatus])
  @@index([createdAt])
  @@map("blogs")
}

model Media {
  id                 String   @id @default(uuid())
  fileName           String   @map("file_name")
  fileUrl            String   @map("file_url")
  fileType           String   @map("file_type")
  fileSize           Int      @map("file_size")
  cloudinaryPublicId String   @map("cloudinary_public_id")
  eventId            String?  @map("event_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  event              Event?   @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@index([fileType])
  @@map("media")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  link      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("announcements")
}

model Contact {
  id         String   @id @default(uuid())
  name       String
  email      String
  subject    String?
  message    String
  isResolved Boolean  @default(false) @map("is_resolved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isResolved])
  @@map("contacts")
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("newsletter_subscribers")
}

model EventRegistration {
  id                  String   @id @default(uuid())
  eventId             String   @map("event_id")
  name                String
  email               String
  contact             String?
  registrationDetails String?  @map("registration_details")
  registeredAt        DateTime @default(now()) @map("registered_at")
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_registrations")
}

model StudentBranch {
  id          String          @id @default(uuid())
  name        String          @unique
  code        String?
  established DateTime?
  logoUrl     String?         @map("logo_url")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  officers    BranchOfficer[]

  @@map("student_branches")
}

model BranchOfficer {
  id            String        @id @default(uuid())
  name          String
  role          String
  ieeeNumber    String?       @map("ieee_number")
  email         String?
  year          Int
  branchId      String        @map("branch_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  studentBranch StudentBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_officers")
}

model GrantAndAward {
  id           String   @id @default(uuid())
  title        String
  category     String
  organization String
  amount       String
  year         String
  status       String
  badgeColor   String?  @map("badge_color")
  icon         String   @default("Award")
  description  String
  impact       String?
  linkUrl      String?  @map("link_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("grants_and_awards")
}
